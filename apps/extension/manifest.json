{
  "manifest_version": 3,
  "name": "DoggyNote Clipper",
  "description": "Save images from the web to your DoggyNote boards’ Inboxes.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "contextMenus", "identity", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "DoggyNote Clipper", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["paw.svg"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
