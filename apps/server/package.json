{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply doggynote --local && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "create-user": "node --experimental-strip-types --no-warnings scripts/create-user.ts",
    "e2e:serve": "./scripts/e2e-serve.sh",
    "db:migrate": "wrangler d1 migrations apply doggynote --remote",
    "deploy:all": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@doggynote/core": "workspace:*",
    "@doggynote/theme": "workspace:*",
    "hono": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "wrangler": "^4.40.0"
  }
}
